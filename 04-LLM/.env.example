# LLM 平台密钥（本文件已在 .gitignore 中，切勿提交）
# 复制本文件为 .env 后填入你自己的 key

# 当前使用的 Provider（deepseek / qwen / zhipu）
TMF_LLM_PROVIDER=deepseek

# 通义千问（阿里百炼）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 智谱 GLM
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4-flash

# 可选：LLM 上游总时间预算（秒）。默认 12，必须小于网关对 LLM worker 的 15s 超时。
# 支持通过环境变量或本文件覆盖；示例值仅供说明，不作为已测 SLO。
# TMF_LLM_TOTAL_TIMEOUT_S=12

